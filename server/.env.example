# Copy to .env (git-ignored) and fill in.
PORT=8787

# Supabase -> Project Settings -> Database -> Connection string (use the pooler URL for serverless hosts)
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Supabase -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-side only. Used to delete a user's login when they delete their account. Never ship this in the app.
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Losing this key makes every stored entry unreadable. Back it up somewhere other than the database.
ENTRY_ENCRYPTION_KEY=

# Comma-separated web origins allowed to call the API (Expo web dev server by default)
CORS_ORIGINS=http://localhost:8081

# TypeSafe API key (console.typesafe.ai/keys). Entry text is sent to TypeSafe for scoring.
JEV_API_KEY=
# Optional. Pin a model version once you have tuned thresholds; aliases like jev-latest move when TypeSafe ships.
# JEV_MODEL=jev-1.13.0
