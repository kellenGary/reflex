# Public app config (EXPO_PUBLIC_ values are bundled into the app, so only put public values here).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The *publishable* key (sb_publishable_...) from Supabase -> Project Settings -> API Keys. Never the secret key.
EXPO_PUBLIC_SUPABASE_KEY=
# The reflex-server URL. Physical phones can't reach localhost: use your computer's LAN address instead.
EXPO_PUBLIC_API_URL=http://localhost:8787
